generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum LabTestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model LabTest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  checkupId     String
  appointmentId String
  patientId     String
  doctorId      String
  testType      String
  status        LabTestStatus
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LabReport {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  labTestId     String
  appointmentId String
  patientId     String
  doctorId      String
  resultData    Json?
  reportUrls    String[]
  uploadedBy    String
  createdAt     DateTime @default(now())
}
  
